# Frontend environment — copy to .env.local (never commit .env.local)

# ── API ───────────────────────────────────────────────────────────────────────
# FastAPI backend (backend/app). Local default port is 10000 (render.yaml).
NEXT_PUBLIC_API_URL=http://localhost:10000

# ── Demo mode ─────────────────────────────────────────────────────────────────
# "true" (default): pages fall back to built-in mock data so the UI is
# explorable without the backend running.
# Set to "false" to force live-backend calls everywhere.
NEXT_PUBLIC_USE_MOCKS=true

# ── Cloudinary (direct browser upload) ────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Dev-only credential hint on /login ────────────────────────────────────────
# "true" shows a box with the seeded test accounts (citizen, admin,
# superadmin, per-department managers/employees). Requires the backend to
# run with SEED_TEST_ACCOUNTS=true. Never enable in production.
NEXT_PUBLIC_SHOW_DEV_CREDS=false
