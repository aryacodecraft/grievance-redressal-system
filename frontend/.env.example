# Frontend environment — copy to .env.local (never commit .env.local)

# ── API ───────────────────────────────────────────────────────────────────────
# Flask backend (backend/server.py). Local default port is 10000
# (render.yaml); the legacy HTML pages used :5000.
NEXT_PUBLIC_API_URL=http://localhost:10000

# ── Demo mode ─────────────────────────────────────────────────────────────────
# "true" (default): pages fall back to built-in mock data so the UI is
# explorable without backend / Firebase credentials.
# Set to "false" to force live-backend calls everywhere.
NEXT_PUBLIC_USE_MOCKS=true

# ── Cloudinary (direct browser upload, same flow as legacy UI) ────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── NextAuth v5 (Auth.js) — deferred; demo session used for now ───────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme-use-openssl-rand-base64-32

# ── Google OAuth 2.0 — deferred ───────────────────────────────────────────────
# Same credentials as backend; add http://localhost:3000/api/auth/callback/google
# to Authorized redirect URIs in Google Cloud Console
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
