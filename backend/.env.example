# Backend environment — copy to backend/.env (never commit .env)

# ── MongoDB Atlas (you set this up) ───────────────────────────────────────────
# Atlas → Database → Add → Free (M0) → Connect → Drivers → copy the URI.
# Replace <password> and the db name if you change it. The `grievances`
# collection and its indexes are created automatically on first boot.
MONGODB_URI=
MONGODB_DB=grievance
# Optional comma-separated DNS nameservers for MongoDB SRV resolution (default empty uses system DNS).
MONGO_DNS_SERVERS=

# ── LLM classification (optional — falls back to keyword rules without it) ────
GROQ_API_KEY=
# Was `llama-3.3-70b-versatile`, which Groq decommissioned (it 404s) — that
# silently dropped classification to the keyword fallback. Use a model your key
# actually has access to; `openai/gpt-oss-20b` is confirmed working here.
GROQ_MODEL=openai/gpt-oss-20b
HF_API_TOKEN=
# Optional alias: config.py accepts either name for the HuggingFace token.
# Set one of the two, not both.
HUGGINGFACE_API_TOKEN=
IMAGE_LLM_THRESHOLD=60
# Vision model for the LLM half of POST /validate-image (services/image.py).
# The heuristic quality fallback runs whenever this call fails or the key is unset.
LLAVA_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Cloudinary (optional — image sign/validate/delete) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Authentication (JWT + RBAC) ───────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Seed one admin account on startup (ignored if the email is already registered).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Seed one system superadmin (manages admins/roles/permissions/departments).
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Demo fallback: allow unauthenticated submit with body userId (dev only).
ALLOW_DEMO_SUBMIT=true
# Testing-phase accounts (dev only — keep false/empty in production).
# When true, startup seeds one MANAGER + one EMPLOYEE per department
# (idempotent; existing emails untouched). Passwords default to the
# documented dev values unless SEED_TEST_PASSWORD overrides them.
SEED_TEST_ACCOUNTS=false
SEED_TEST_PASSWORD=

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Create credentials at https://console.developers.google.com/
# Authorised redirect URI: http://localhost:10000/auth/google/callback (local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL of the Next.js frontend (used for post-OAuth redirects)
FRONTEND_URL=http://localhost:3000

# ── Face authentication (optional — off by default, DEC-024) ─────────────────
# Requires the optional face stack: pip install -r backend/requirements-face.txt
# When false every /auth/face route returns 404 and the UI hides face options.
FACE_AUTH_ENABLED=false
# Fernet key for face embeddings at rest (required when the flag is on;
# startup fails without it). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_EMBED_KEY=
# insightface model pack. Stored in each template; changing it forces
# re-enrollment (reason code MODEL_MISMATCH).
FACE_MODEL_NAME=buffalo_s
# 1:1 cosine-similarity match threshold (0..1).
FACE_MATCH_THRESHOLD=0.45
# Pairwise cosine-similarity consistency threshold across captured frontal frames (0..1).
FACE_CONSISTENCY_THRESHOLD=0.30
# Cosine similarity binding threshold between liveness action frame and frontal face (0..1).
FACE_BINDING_THRESHOLD=0.25
# Optional Silent-Face-Anti-Spoofing ONNX model path (empty = check disabled).
FACE_ANTISPOOF_MODEL_PATH=
# Liveness/quality thresholds — defaults suit a decent webcam; if capture fails
# closed on your camera, relax these (e.g. TURN_MIN 10, BLUR 15, MIN_FACE_PX 60)
# instead of changing code. Values are read per request at verification time.
FACE_TURN_MIN_DEGREES=15.0
FACE_BLINK_EAR_DROP=0.7
FACE_SMILE_MOUTH_WIDEN=1.08
FACE_MIN_BLUR_VARIANCE=30.0
FACE_MIN_FACE_PX=80
# Detection model input size (square, default 320 for CPU speed; min 320).
FACE_DET_SIZE=320
# Local debug metrics logged per attempt (local only; false in production).
FACE_DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=10000
CORS_ORIGINS=http://localhost:3000
# Trust X-Forwarded-Proto for HTTPS detection on face routes (true behind a
# terminating proxy; keep false otherwise).
TRUST_PROXY=false
