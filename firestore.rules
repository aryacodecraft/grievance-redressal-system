rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // helper: is this user one of the admins?
    // This is what grants access if the authenticated user's email is in the list.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "aryaadmin@gmail.com",    // <-- 🔑 Ensure your admin email is here
        ];
    }

    match /grievances/{docId} {

      // citizens can read their own grievances
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // citizens can create only their own grievances with required fields
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['title','description','userId','status','createdAt']);

      // citizens can update own grievances BUT cannot touch admin-only fields
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status','resolvedAt','hfEngine','category','priority','updatedAt','imageValidation']);

      // admins can read/write ALL grievances
      allow read, write: if isAdmin();
    }
  }
}